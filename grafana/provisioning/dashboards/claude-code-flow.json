        "query": {
          "qryType": 3,
          "query": "query_result(group by (persona) (last_over_time(claude_code_active_time_seconds_total{host_name=~\"$host\", user_email=~\"$user\", persona!=\"\"}[$__range])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(group by (persona) (last_over_time(claude_code_active_time_seconds_total{host_name=~\"$host\", user_email=~\"$user\", persona!=\"\"}[$__range])))",
        "refresh": 2,
